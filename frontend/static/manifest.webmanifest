{
	"name": "Cryptorum",
	"short_name": "Cryptorum",
	"id": "/",
	"description": "Personal digital library reader",
	"start_url": "/",
	"scope": "/",
	"display": "fullscreen",
	"display_override": ["fullscreen", "standalone", "browser"],
	"background_color": "#0f172a",
	"theme_color": "#0f172a",
	"orientation": "any",
	"categories": ["books", "productivity", "utilities"],
	"icons": [
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
